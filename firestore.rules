rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /tournaments/{id} { allow read: if true; allow write: if false; }
  match /tournamentDrafts/{id} { allow read: if request.auth != null && request.auth.token.admin == true; }
  match /fencerProfiles/{id} { allow read: if request.auth != null && request.auth.token.admin == true; }
  match /{document=**} { allow read, write: if false; }
 }
}
