{
  "name": "hema-tournament-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:backend": "npm --prefix functions run build",
    "test:firebase": "firebase emulators:exec --project demo-hema --only auth,firestore,functions 'node scripts/test-firebase.mjs'",
    "emulators": "firebase emulators:start --project demo-hema --only auth,firestore,functions",
    "deploy": "npm run build && firebase deploy --project jhematournamentapp --only hosting,firestore,functions,storage",
    "format": "prettier --write src shared functions/src tests scripts *.ts *.json *.md .github"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
